//! The bindings of the external component `WordCounter`, generated by `inset
//! build` from its declaration. It is written again on every build.
//!
//! Implement [`WordCounter`] for a type of your own, and name the type with
//! [`export!`].

#[doc(hidden)]
#[allow(unsafe_code, clippy::all)]
pub mod bindings {
    wit_bindgen::generate!({
        path: "../word-counter/wit",
        world: "external",
        pub_export_macro: true,
        export_macro_name: "__export",
        default_bindings_module: "interface::bindings",
    });
}

pub use bindings::exports::inset::word_counter::word_counter::{Length, Word};

pub trait WordCounter: 'static {
    /// Starts the component, before its first message and again after it restarts.
    fn new() -> Self;

    /// Adds the words in `text` to the count, and returns the count. Panics on the word "panic".
    fn add(&mut self, text: &str) -> u64;

    /// Each word in `text`, with its length and the word before it.
    fn split(&self, text: String) -> Vec<Word>;

    /// Tries to read the file `path`, and says what happened.
    fn read_file(&self, path: &str) -> Result<String, String>;
}

/// Makes a type that implements [`WordCounter`] the component's code.
#[macro_export]
macro_rules! export {
    ($ty:ty) => {
        const _: () = {
            struct __InsetExported;

            struct __InsetInstance(::core::cell::RefCell<$ty>);

            impl $crate::bindings::exports::inset::word_counter::word_counter::Guest for __InsetExported {
                type WordCounter = __InsetInstance;
            }

            impl $crate::bindings::exports::inset::word_counter::word_counter::GuestWordCounter for __InsetInstance {
                fn new() -> Self {
                    __InsetInstance(::core::cell::RefCell::new(<$ty as $crate::WordCounter>::new()))
                }

                fn add(&self, text: ::std::string::String) -> u64 {
                    <$ty as $crate::WordCounter>::add(&mut *self.0.borrow_mut(), &text)
                }
                fn split(&self, text: ::std::string::String) -> ::std::vec::Vec<$crate::Word> {
                    <$ty as $crate::WordCounter>::split(&*self.0.borrow(), text)
                }
                fn read_file(&self, path: ::std::string::String) -> ::core::result::Result<::std::string::String, ::std::string::String> {
                    <$ty as $crate::WordCounter>::read_file(&*self.0.borrow(), &path)
                }
            }

            $crate::bindings::__export!(__InsetExported with_types_in $crate::bindings);
        };
    };
}
