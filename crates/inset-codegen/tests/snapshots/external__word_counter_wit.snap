// Generated by `inset build` from the declaration of `WordCounter`.
// It is written again on every build.

package inset:word-counter;

interface word-counter {
    /// How long a word is.
    variant length {
        /// Three letters or fewer.
        short,
        /// More than three letters, with how many.
        long(u32),
    }

    /// A word, with its length.
    record word {
        text: string,
        length: length,
        /// The word before it, if any.
        after: option<string>,
    }

    resource word-counter {
        /// Starts the component, before its first message and again after it restarts.
        constructor();

        /// Adds the words in `text` to the count, and returns the count. Panics on the word "panic".
        add: func(text: string) -> u64;

        /// Each word in `text`, with its length and the word before it.
        split: func(text: string) -> list<word>;

        /// Tries to read the file `path`, and says what happened.
        read-file: func(path: string) -> result<string, string>;
    }
}

world external {
    export word-counter;
}
