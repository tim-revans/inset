---
source: crates/inset-codegen/tests/hello.rs
expression: "cargo_toml(\"hello-http\", Path::new(\"/inset/crates/inset-runtime\"))"
---
# Generated by `inset build`. It is written again on every build.

[package]
name = "hello-http"
version = "0.0.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
inset-runtime = { path = "/inset/crates/inset-runtime" }

# Inset checks integer arithmetic in every build.
[profile.release]
overflow-checks = true

# A project of its own, wherever it is written.
[workspace]
