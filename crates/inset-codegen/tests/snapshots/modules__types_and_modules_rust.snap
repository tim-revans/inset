//! The Rust that `inset build` generated for the app `Shelf`.
//! It is written again on every build, so a change to it would be lost.

mod library {
    use crate::{Book, Genre};

    /// Why a book is not lent.
    #[derive(Debug)]
    pub enum LendError {
        /// No book has the title.
        Unknown,
        /// Every copy is out. Says which book.
        AllOut(String),
        /// The title is too short to look for.
        TooShort,
    }

    impl ::inset_runtime::Status for LendError {
        fn into_reply(self) -> ::inset_runtime::Reply {
            match self {
                Self::Unknown => ::inset_runtime::Reply::empty(404),
                Self::AllOut(text) => ::inset_runtime::Reply::text(409, text),
                Self::TooShort => ::inset_runtime::Reply::empty(400),
            }
        }
    }

    impl ::inset_runtime::Stored for LendError {
        fn to_json(&self) -> ::inset_runtime::Json {
            match self {
                Self::Unknown => ::inset_runtime::data::variant("Unknown", Vec::new()),
                Self::AllOut(field0) => {
                    ::inset_runtime::data::variant(
                        "AllOut",
                        Vec::from([::inset_runtime::Stored::to_json(field0)]),
                    )
                }
                Self::TooShort => ::inset_runtime::data::variant("TooShort", Vec::new()),
            }
        }

        fn from_json(json: &::inset_runtime::Json) -> Result<Self, String> {
            let (variant, fields) = ::inset_runtime::data::to_variant(json)?;
            match variant {
                "Unknown" => {
                    ::inset_runtime::data::arity("Unknown", fields, 0)?;
                    Ok(Self::Unknown)
                }
                "AllOut" => {
                    ::inset_runtime::data::arity("AllOut", fields, 1usize)?;
                    Ok(Self::AllOut(::inset_runtime::Stored::from_json(&fields[0])?))
                }
                "TooShort" => {
                    ::inset_runtime::data::arity("TooShort", fields, 0)?;
                    Ok(Self::TooShort)
                }
                other => ::inset_runtime::data::unknown_variant("LendError", other),
            }
        }
    }

    /// The lending desk.
    pub struct Desk {
        pub http: ::inset_runtime::HttpServer,
    }

    impl Desk {
        /// Lends a copy of a book, and replies with how many copies are left.
        fn lend(title: String) -> Result<String, LendError> {
            let book = find(&title)?;
            if book.copies == 0 {
                return Err(
                    LendError::AllOut(format!("every copy of {} is out", book.title)),
                );
            }
            Ok(format!("{} left", book.copies - 1))
        }

        /// Lists the titles of a genre, in shelf order.
        fn genre(name: String) -> Option<String> {
            let genre = match name.as_str() {
                "fiction" => Genre::Fiction,
                "science" => Genre::Science,
                "history" => Genre::History,
                _ => return None,
            };
            let mut titles = Vec::new();
            for book in shelf() {
                if book.genre == genre {
                    titles.push(book.title);
                }
            }
            Some(titles.join(", "))
        }
    }

    impl ::inset_runtime::Component for Desk {
        const NAME: &'static str = "Desk";

        type Saved = ();

        fn save(&self) {}

        fn restore(&mut self, (): ()) {}

        fn servers(&self) -> Vec<(&'static str, &::inset_runtime::HttpServer)> {
            Vec::from([("http", &self.http)])
        }

        fn route(
            field: &str,
            request: &::inset_runtime::Request,
        ) -> ::inset_runtime::Route<Self> {
            if field == "http" {
                if let Some(path) = request
                    .route(::inset_runtime::Method::Get, "/lend/{title}")
                {
                    let Some(title) = path.get("title") else {
                        return ::inset_runtime::Route::NotFound;
                    };
                    return ::inset_runtime::Route::to(move |_: &mut Self| {
                        Box::pin(async move { Self::lend(title) })
                    });
                }
                if let Some(path) = request
                    .route(::inset_runtime::Method::Get, "/genres/{name}")
                {
                    let Some(name) = path.get("name") else {
                        return ::inset_runtime::Route::NotFound;
                    };
                    return ::inset_runtime::Route::to(move |_: &mut Self| {
                        Box::pin(async move { Self::genre(name) })
                    });
                }
            }
            ::inset_runtime::Route::NotFound
        }
    }

    /// Every book on the shelf.
    fn shelf() -> Vec<Book> {
        vec![
            Book { title : "Dune".to_string(), copies : 2, genre : Genre::Fiction }, Book
            { title : "Cosmos".to_string(), copies : 1, genre : Genre::Science }, Book {
            title : "Emma".to_string(), copies : 3, genre : Genre::Fiction }, Book {
            title : "SPQR".to_string(), copies : 0, genre : Genre::History }
        ]
    }

    /// The book with this title.
    fn find(title: &str) -> Result<Book, LendError> {
        if title.len() < 3 {
            return Err(LendError::TooShort);
        }
        for book in shelf() {
            if book.title == title {
                return Ok(book);
            }
        }
        Err(LendError::Unknown)
    }
}

use library::Desk;

/// Lends books over HTTP.
struct Shelf;

impl ::inset_runtime::App for Shelf {
    const NAME: &'static str = "Shelf";

    const SETTINGS: &'static [::inset_runtime::Setting] = &[
        ::inset_runtime::Setting {
            name: "port",
            ty: ::inset_runtime::SettingType::U16,
            default: "8080",
        },
    ];

    const GRANTS: &'static [::inset_runtime::Grant] = &[
        ::inset_runtime::Grant {
            name: "http",
            capability: "HttpServer",
            fields: &[("port", ::inset_runtime::GrantValue::Setting("port"))],
        },
    ];

    fn start(
        scope: &::inset_runtime::Scope,
        grants: &mut ::inset_runtime::Grants,
    ) -> Result<(), ::inset_runtime::Stopped> {
        let http = grants.http_server("http");
        scope.start(|_| Desk { http });
        Ok(())
    }
}

::inset_runtime::export!(Shelf);

/// A book on the shelf.
#[derive(Clone, Debug, PartialEq)]
struct Book {
    /// The title, as printed on the cover.
    title: String,
    /// How many copies are on the shelf.
    copies: u32,
    genre: Genre,
}

impl ::inset_runtime::Stored for Book {
    fn to_json(&self) -> ::inset_runtime::Json {
        ::inset_runtime::data::object(
            Vec::from([
                ("title", ::inset_runtime::Stored::to_json(&self.title)),
                ("copies", ::inset_runtime::Stored::to_json(&self.copies)),
                ("genre", ::inset_runtime::Stored::to_json(&self.genre)),
            ]),
        )
    }

    fn from_json(json: &::inset_runtime::Json) -> Result<Self, String> {
        let fields = ::inset_runtime::data::fields("Book", json)?;
        Ok(Book {
            title: fields.get("title")?,
            copies: fields.get("copies")?,
            genre: fields.get("genre")?,
        })
    }
}

/// What a book is about.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
enum Genre {
    Fiction,
    Science,
    History,
}

impl ::inset_runtime::Stored for Genre {
    fn to_json(&self) -> ::inset_runtime::Json {
        match self {
            Self::Fiction => ::inset_runtime::data::variant("Fiction", Vec::new()),
            Self::Science => ::inset_runtime::data::variant("Science", Vec::new()),
            Self::History => ::inset_runtime::data::variant("History", Vec::new()),
        }
    }

    fn from_json(json: &::inset_runtime::Json) -> Result<Self, String> {
        let (variant, fields) = ::inset_runtime::data::to_variant(json)?;
        match variant {
            "Fiction" => {
                ::inset_runtime::data::arity("Fiction", fields, 0)?;
                Ok(Self::Fiction)
            }
            "Science" => {
                ::inset_runtime::data::arity("Science", fields, 0)?;
                Ok(Self::Science)
            }
            "History" => {
                ::inset_runtime::data::arity("History", fields, 0)?;
                Ok(Self::History)
            }
            other => ::inset_runtime::data::unknown_variant("Genre", other),
        }
    }
}
