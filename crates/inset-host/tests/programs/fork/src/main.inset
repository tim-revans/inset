// `fork for` in a handler whose branches await messages, in a handler whose
// branches only compute, and in an algorithm. `tests/fork.rs` runs it.

app Forks {
    grant http: HttpServer { port: 8080 };
    grant counts: Table<String, u32> { file: "forks.db", name: "counts" };
    start Desk { http: move http, counts: move counts };
}

/// Asks the clerk about many names at once.
component Desk {
    http: HttpServer,
    counts: Table<String, u32>,

    start clerk: Clerk { notes: Vec::new() };

    /// Asks the clerk about each name in a list separated by commas, all at
    /// once, and replies with each name and the clerk's answer, in order.
    #[post("/ask", via = http, body = text)]
    async fn ask(&self, text: String) -> String {
        let names = split(&text);
        let answers = fork for name in &names {
            let heard = self.clerk.note(format!("{name} asks")).await;
            self.clerk.note(format!("{name} thanks")).await;
            format!("{name}={heard}")
        };
        answers.join(",")
    }

    /// What the clerk was told, in the order it was told it.
    #[get("/notes", via = http)]
    async fn read_notes(&self) -> String {
        self.clerk.notes().await
    }

    /// Counts up to `n` in branches of a fork, and stores how many there were.
    #[post("/count/{n}", via = http)]
    async fn count(&mut self, n: u32) -> String {
        let branches = fork for i in 0..n {
            i
        };
        let counted = branches.len() as u32;
        self.counts.insert("count".to_string(), counted).await;
        counted.to_string()
    }
}

/// Keeps what it is told.
component Clerk {
    notes: Vec<String>,

    /// Keeps a note, and replies with how many notes it has kept.
    #[message]
    fn note(&mut self, note: String) -> usize {
        self.notes.push(note);
        self.notes.len()
    }

    /// Every note, separated by commas.
    #[message]
    fn notes(&self) -> String {
        self.notes.join(",")
    }
}

/// The names in a list separated by commas, each without the spaces around
/// it. An empty list has no names.
fn split(text: &str) -> Vec<String> {
    if text.is_empty() {
        return Vec::new();
    }
    fork for name in text.split(',') {
        name.trim().to_string()
    }
}
