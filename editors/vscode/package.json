{
  "name": "inset",
  "displayName": "Inset",
  "description": "The Inset language: highlighting, and live diagnostics, hover, go-to-definition and outline from its language server",
  "version": "0.1.0",
  "publisher": "inset",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node test/grammar.test.mjs",
    "package": "vsce package --skip-license --allow-missing-repository"
  },
  "contributes": {
    "languages": [
      {
        "id": "inset",
        "aliases": [
          "Inset"
        ],
        "extensions": [
          ".inset"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/inset.svg",
          "dark": "./icons/inset.svg"
        }
      },
      {
        "id": "inset-req",
        "aliases": [
          "Inset requirements"
        ],
        "extensions": [
          ".req.inset"
        ],
        "configuration": "./requirements-language-configuration.json",
        "icon": {
          "light": "./icons/inset-req.svg",
          "dark": "./icons/inset-req.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "inset",
        "scopeName": "source.inset",
        "path": "./syntaxes/inset.tmLanguage.json"
      },
      {
        "language": "inset-req",
        "scopeName": "source.inset-req",
        "path": "./syntaxes/inset-req.tmLanguage.json"
      },
      {
        "scopeName": "markdown.inset.codeblock",
        "path": "./syntaxes/inset-markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.inset": "inset",
          "meta.embedded.block.inset-req": "inset-req"
        }
      }
    ],
    "configuration": {
      "title": "Inset",
      "properties": {
        "inset.server.path": {
          "type": "string",
          "default": "inset",
          "markdownDescription": "The `inset` command, which runs the language server as `inset lsp`. A bare name is looked up on `PATH`."
        }
      }
    },
    "commands": [
      {
        "command": "inset.restartServer",
        "title": "Restart the language server",
        "category": "Inset"
      }
    ],
    "configurationDefaults": {
      "[inset]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "[inset-req]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "markup.heading.requirement.inset-req",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "storage.modifier.boundary.inset",
              "keyword.control.send.inset",
              "keyword.control.fork.inset"
            ],
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "support.type.capability.inset",
              "variable.other.capability.inset",
              "variable.other.capability.inset-req"
            ],
            "settings": {
              "fontStyle": "underline"
            }
          }
        ]
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  }
}
