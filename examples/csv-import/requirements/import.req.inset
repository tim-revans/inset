requirement "A valid price list is stored, with VAT added to each net price"
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,M6 bolt,0.10
        nut-m6,M6 nut,0.05
        """
    then PriceImport replies OK with "Products imported: 2"
    and products["bolt-m6"] is Product { name: "M6 bolt", net: 0.10, gross: 0.12 }
    and products["nut-m6"] is Product { name: "M6 nut", net: 0.05, gross: 0.06 }

requirement "A field in quotes may contain commas"
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,"Bolt, M6",0.10
        """
    then PriceImport replies OK with "Products imported: 1"
    and products["bolt-m6"] is Product { name: "Bolt, M6", net: 0.10, gross: 0.12 }

requirement "A price list with no products is accepted and stores nothing"
    given products is empty
    when PriceImport receives POST /price-lists with "sku,name,net\n"
    then PriceImport replies OK with "Products imported: 0"
    and products is empty

requirement "A price list with any invalid row is refused whole, naming each invalid line"
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,M6 bolt,0.10
        nut-m6,M6 nut
        washer-m6,M6 washer,free
        """
    then PriceImport replies BadRequest with
        """
        line 3: expected 3 fields, found 2
        line 4: net price "free" is not a price
        """
    and products is empty

requirement "A net price that is negative, has more than two decimal places or is not a number is refused"
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,M6 bolt,<net>
        """
    then PriceImport replies BadRequest with
        """
        line 2: net price "<net>" is not a price
        """
    and products is empty
    examples
    | net   |
    | -1.00 |
    | 0.125 |
    | free  |

requirement "Any net price of zero or more, with at most two decimal places, is stored exactly"
    for all net: Decimal where net >= dec!(0) && net.scale() <= 2
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,M6 bolt,<net>
        """
    then PriceImport replies OK with "Products imported: 1"
    and products["bolt-m6"].net == <net>

requirement "The gross price is never below the net price"
    for all net: Decimal where net >= dec!(0) && net.scale() <= 2
    given products is empty
    when PriceImport receives POST /price-lists with
        """
        sku,name,net
        bolt-m6,M6 bolt,<net>
        """
    then PriceImport replies OK with "Products imported: 1"
    and products["bolt-m6"].gross >= <net>
