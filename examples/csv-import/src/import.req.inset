requirement "A valid price list is stored, with VAT added to each net price"
  component Importer
  given products is empty
  when Importer receives POST /price-lists with
    """
    sku,name,net
    bolt-m6,M6 bolt,0.10
    nut-m6,M6 nut,0.05
    """
  then Importer replies OK with "Imported 2 products"
  and products["bolt-m6"] is Product { name: "M6 bolt", net: 0.10, gross: 0.12 }
  and products["nut-m6"] is Product { name: "M6 nut", net: 0.05, gross: 0.06 }

requirement "A price list with any invalid row is refused whole, naming each invalid line"
  component Importer
  given products is empty
  when Importer receives POST /price-lists with
    """
    sku,name,net
    bolt-m6,M6 bolt,0.10
    nut-m6,M6 nut
    washer-m6,M6 washer,free
    """
  then Importer replies BadRequest with
    """
    line 3: expected 3 fields, found 2
    line 4: net price "free" is not a price
    """
  and products is empty

requirement "The CSV reader keeps each row's line number, and commas inside quotes"
  component CsvReader
  when CsvReader receives read("sku,name,net\nbolt-m6,\"Bolt, M6\",0.10\nnut-m6\n")
  then CsvReader replies [
      Row { line: 2, fields: ["bolt-m6", "Bolt, M6", "0.10"] },
      Row { line: 3, fields: ["nut-m6"] },
    ]

requirement "Prices are zero or more pounds, with at most two decimal places"
  algorithm parse_price
  | text    | price       |
  | "12.50" | Some(12.50) |
  | "0"     | Some(0)     |
  | "-1.00" | None        |
  | "0.125" | None        |
  | "free"  | None        |

requirement "Any price with at most two decimal places reads back as itself"
  algorithm parse_price
  for all price: Decimal where price >= dec!(0) && price.scale() <= 2
    parse_price(&price.to_string()) == Some(price)

requirement "The gross price of a whole number of pence is never below the net price"
  algorithm add_vat
  for all net: Decimal where net >= dec!(0) && net.scale() <= 2
    add_vat(net) >= net
