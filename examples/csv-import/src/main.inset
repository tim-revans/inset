/// Price import: stores a supplier's price list in the product catalogue.
app PriceImport {
    /// The port to serve on.
    setting port: u16 = 8080;
    /// The catalogue database, which other tools also read.
    setting catalogue: String = "catalogue.db";
    grant http: HttpServer { port };
    grant products: Table<String, Product> { file: catalogue, name: "products" };
    start Importer { http: move http, products: move products };
}

/// A product in the catalogue, stored under its SKU. Prices are in pounds.
#[derive(Clone, Debug, PartialEq)]
struct Product {
    name: String,
    /// The price before VAT.
    net: Decimal,
    /// The price with VAT added.
    gross: Decimal,
}

/// One row of a CSV file.
#[derive(Clone, Debug, PartialEq)]
struct Row {
    /// The line the row is on, counting the header as line 1.
    line: u64,
    fields: Vec<String>,
}

/// Why a price list was not imported.
#[derive(Clone, Debug, PartialEq)]
enum ImportError {
    /// Some rows are invalid. Describes each one, one per line.
    #[status(BadRequest)]
    InvalidRows(String),
}

/// Reads CSV text with the `csv` crate. Holds no capabilities, so it can only compute.
#[rust(path = "csv_reader.rs", crates = ["csv@1.3"])]
extern component CsvReader {
    /// Reads every row after the header line, whatever number of fields it has.
    #[message]
    fn read(&self, text: &String) -> Vec<Row>;
}

/// Accepts price lists over HTTP and stores their products.
component Importer {
    http: HttpServer,
    products: Table<String, Product>,

    start csv: CsvReader {};

    /// Stores every product in a price list, or none if any row is invalid.
    /// A price list is CSV with a header line, then one row per product: SKU, name, net price.
    #[post("/price-lists", via = http, body = text)]
    async fn import(&mut self, text: String) -> Result<String, ImportError> {
        let rows = self.csv.read(&text).await;
        let products = match parse_price_list(&rows) {
            Ok(products) => products,
            Err(errors) => return Err(ImportError::InvalidRows(errors)),
        };
        let count = products.len();
        for (sku, product) in products {
            self.products.insert(sku, product).await;
        }
        Ok(format!("Products imported: {count}"))
    }
}

/// Reads every row of a price list, or describes every invalid row, one per line.
fn parse_price_list(rows: &Vec<Row>) -> Result<Vec<(String, Product)>, String> {
    let results = fork for row in rows {
        parse_row(row)
    };
    let mut products = Vec::new();
    let mut errors = String::new();
    for result in results {
        match result {
            Ok(product) => products.push(product),
            Err(error) => errors.push_str(&format!("{error}\n")),
        }
    }
    if errors.is_empty() {
        Ok(products)
    } else {
        Err(errors)
    }
}

/// Reads one row: a SKU, a product name and a net price.
fn parse_row(row: &Row) -> Result<(String, Product), String> {
    if row.fields.len() != 3 {
        return Err(format!("line {}: expected 3 fields, found {}", row.line, row.fields.len()));
    }
    let Some(net) = parse_price(&row.fields[2]) else {
        return Err(format!("line {}: net price {:?} is not a price", row.line, row.fields[2]));
    };
    let product = Product { name: row.fields[1].clone(), net, gross: add_vat(net) };
    Ok((row.fields[0].clone(), product))
}

/// Reads a price of zero or more pounds with at most two decimal places, such as `12.50`.
fn parse_price(text: &String) -> Option<Decimal> {
    match text.parse::<Decimal>() {
        Ok(price) if price >= dec!(0) && price.scale() <= 2 => Some(price),
        _ => None,
    }
}

/// Adds VAT at 20%, rounded to the nearest penny.
fn add_vat(net: Decimal) -> Decimal {
    (net * dec!(1.20)).round_dp(2)
}
