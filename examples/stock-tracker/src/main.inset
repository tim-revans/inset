mod warehouse;

use warehouse::Warehouse;

/// Stock tracker: how many of each item the warehouse holds, and what to reorder.
app StockTracker {
    /// The port to serve on.
    setting port: u16 = 8080;
    grant http: HttpServer { port };
    // The stock database belongs to this tool alone, so its file is fixed.
    grant items: Table<String, Item> { file: "stock.db", name: "items" };
    start Warehouse { http: move http, items: move items };
}

/// A stocked item, stored under its SKU.
#[derive(Clone, Debug, PartialEq)]
struct Item {
    /// How many the warehouse holds.
    on_hand: u32,
    /// Stock at or below this level is reordered.
    reorder_level: u32,
    /// A reorder brings stock back up to this level.
    target_level: u32,
}

/// An order to place with a supplier.
#[derive(Clone, Debug, PartialEq)]
struct Reorder {
    sku: String,
    quantity: u32,
}

/// Why stock could not be shipped.
#[derive(Clone, Debug, PartialEq)]
enum ShipError {
    /// No item has the SKU.
    #[status(NotFound)]
    UnknownItem,
    /// The warehouse holds fewer than the quantity asked for.
    #[status(Conflict)]
    NotEnoughStock,
}
