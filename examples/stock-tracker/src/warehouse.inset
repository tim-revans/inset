use crate::{Item, Reorder, ShipError, StockLevel};

/// Answers HTTP requests from warehouse staff about stock and reorders.
pub component Warehouse {
    http: HttpServer,
    #[handed_down]
    items: Table<String, Item>,

    start reorders: Reorders { orders: Vec::new() };
    start inventory: Inventory { items: move items, low_stock: send reorders.raise };

    failure {
        /// Inventory rolls back a request whose database call fails, so this request fails too.
        Message(inventory) => rollback,
    }

    /// Replies with the quantity on hand.
    #[get("/items/{sku}", via = http)]
    async fn stock(&self, sku: String) -> Option<String> {
        let item = self.inventory.item(&sku).await?;
        Some(item.on_hand.to_string())
    }

    /// Lists every item's stock in SKU order, or with `low=true`, only the
    /// items at or below their reorder level.
    #[get("/items?{low}", via = http)]
    async fn stock_levels(&self, low: Option<bool>) -> Json<Vec<StockLevel>> {
        let levels = self.inventory.levels(low.unwrap_or(false)).await;
        Json(levels)
    }

    /// Stocks an item with the levels given, replacing any it had, and
    /// replies with the quantity on hand.
    #[put("/items/{sku}", via = http, body = item)]
    async fn stock_item(&self, sku: String, item: Json<Item>) -> String {
        let Json(item) = item;
        let on_hand = item.on_hand;
        self.inventory.stock(&sku, move item).await;
        on_hand.to_string()
    }

    /// Adds stock that has arrived, and replies with the new quantity on hand.
    #[post("/items/{sku}/receipts", via = http, body = quantity)]
    async fn receive(&self, sku: String, quantity: u32) -> Option<String> {
        let item = self.inventory.receive(&sku, quantity).await?;
        Some(item.on_hand.to_string())
    }

    /// Takes away stock that has been shipped, and replies with the new quantity on hand.
    #[post("/items/{sku}/shipments", via = http, body = quantity)]
    async fn ship(&self, sku: String, quantity: u32) -> Result<String, ShipError> {
        let item = self.inventory.ship(&sku, quantity).await?;
        Ok(item.on_hand.to_string())
    }

    /// Lists the reorders waiting to be placed, one per line: the SKU, then the quantity.
    #[get("/reorders", via = http)]
    async fn pending_reorders(&self) -> String {
        let orders = self.reorders.pending().await;
        orders.iter().map(|order| format!("{} {}\n", order.sku, order.quantity)).collect()
    }
}

/// Keeps the stock record of every item, and raises a reorder when stock runs low.
component Inventory {
    items: Table<String, Item>,
    /// A reorder for each item that shipping leaves at or below its reorder level.
    low_stock: Outlet<Reorder>,

    failure {
        /// A database error affects only the request it happened in. The next request
        /// may succeed, so the program keeps running.
        Capability(items) => rollback,
    }

    /// The item with this SKU, if there is one.
    #[message]
    async fn item(&self, sku: &str) -> Option<Item> {
        self.items.get(sku).await
    }

    /// Every item's stock, in SKU order, or only that of the items at or
    /// below their reorder level.
    #[message]
    async fn levels(&self, low_only: bool) -> Vec<StockLevel> {
        let mut levels = Vec::new();
        for (sku, item) in self.items.entries().await {
            let low = item.on_hand <= item.reorder_level;
            if low || !low_only {
                levels.push(StockLevel {
                    sku,
                    on_hand: item.on_hand,
                    reorder_level: item.reorder_level,
                    low,
                });
            }
        }
        levels
    }

    /// Stores an item under its SKU, replacing any item stored there.
    #[message]
    async fn stock(&mut self, sku: &str, item: Item) {
        self.items.insert(sku.to_string(), item).await;
    }

    /// Adds to an item's stock, and returns the item as it now stands.
    #[message]
    async fn receive(&mut self, sku: &str, quantity: u32) -> Option<Item> {
        let mut item = self.items.get(sku).await?;
        item.on_hand += quantity;
        self.items.insert(sku.to_string(), item.clone()).await;
        Some(item)
    }

    /// Takes from an item's stock if it holds enough, and returns the item as it now stands.
    /// Raises a reorder if that leaves stock at or below its reorder level.
    #[message]
    async fn ship(&mut self, sku: &str, quantity: u32) -> Result<Item, ShipError> {
        let Some(mut item) = self.items.get(sku).await else {
            return Err(ShipError::UnknownItem);
        };
        if item.on_hand < quantity {
            return Err(ShipError::NotEnoughStock);
        }
        item.on_hand -= quantity;
        self.items.insert(sku.to_string(), item.clone()).await;
        let order = Self::reorder_quantity(item.on_hand, item.reorder_level, item.target_level);
        if order > 0 {
            send self.low_stock.emit(Reorder { sku: sku.to_string(), quantity: order });
        }
        Ok(item)
    }

    /// How many to reorder so that stock goes back up to its target level.
    fn reorder_quantity(on_hand: u32, reorder_level: u32, target_level: u32) -> u32 {
        if on_hand > reorder_level {
            0
        } else {
            target_level.saturating_sub(on_hand)
        }
    }
}

/// Keeps the reorders waiting to be placed, at most one per item.
component Reorders {
    orders: Vec<Reorder>,

    /// Records a reorder, replacing any earlier one for the same item.
    #[message]
    fn raise(&mut self, order: Reorder) {
        if let Some(pending) = self.orders.iter_mut().find(|pending| pending.sku == order.sku) {
            pending.quantity = order.quantity;
        } else {
            self.orders.push(order);
        }
    }

    /// Every reorder waiting to be placed, oldest first.
    #[message]
    fn pending(&self) -> Vec<Reorder> {
        self.orders.clone()
    }
}
